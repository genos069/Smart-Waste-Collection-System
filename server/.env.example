PORT=4000
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017/smart-waste?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173
# Set only to the known number of trusted reverse-proxy hops (0 for local use).
TRUST_PROXY_HOPS=0
# Simulation is opt-in; never silently mutate production bins.
SIMULATE_BINS=false
# Local development only; production must deliver tokens through email.
EXPOSE_RESET_TOKEN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
